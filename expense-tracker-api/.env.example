# Backend environment variables.
# Copy this file to .env (gitignored) and fill in real values. NEVER commit .env.
#
# ┌─ WHERE TO FIND THESE (Supabase dashboard: https://supabase.com/dashboard) ─┐
# │ Open your project, then:                                                   │
# │  • DATABASE_URL  → green "Connect" button (top bar) → "Direct / Connection │
# │                    string" tab → choose "Session pooler" → copy the URI.   │
# │  • SUPABASE_URL & SERVICE_ROLE_KEY → gear icon "Settings" (bottom-left) →   │
# │                    "API Keys" / "API" (Project URL + service_role key).    │
# │ Supabase changes this UI often; if a label moved, look for "Connect" and   │
# │ "Settings → API". The frontend keys live in expense-tracker/.env.example.  │
# └────────────────────────────────────────────────────────────────────────────┘

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default — zero config). database.py falls back to this if DATABASE_URL
# is unset, so leaving it empty keeps local SQLite behavior. NOTE: SQLite is a
# separate empty local file — it will NOT show your real Supabase data. For your
# real data, use the PostgreSQL line below instead.
DATABASE_URL=sqlite:///./expense_tracker.db

# PostgreSQL / Supabase — this is the one that connects to your real data.
# WHERE: dashboard → "Connect" (top bar) → "Direct / Connection string" tab →
#        select "Session pooler" → copy the URI shown.
# THEN fix three things on the copied string:
#   1. Replace [YOUR-PASSWORD] with your database password. Forgot it? Settings →
#      Database → "Reset database password" (this invalidates the old one).
#   2. Make sure the port is 5432 (Session pooler). The 6543 "Transaction pooler"
#      breaks SQLAlchemy prepared statements — do NOT use it.
#   3. Keep (or append) ?sslmode=require at the end — Supabase's copy button
#      sometimes omits it.
# database.py rewrites postgresql:// to postgresql+psycopg:// automatically.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# ── AUTH-01: Supabase JWT verification ────────────────────────────────────────
# REQUIRED — the backend refuses to start if unset (no hardcoded fallback, so a
# real project ref is never baked into source). Used to derive the JWKS endpoint
# and validate the `iss` claim.
# WHERE: dashboard → Settings (gear, bottom-left) → API → "Project URL".
#        Same value goes in the frontend's VITE_SUPABASE_URL.
SUPABASE_URL=https://<project-ref>.supabase.co

# ── FEAT-14: Supabase service-role key (admin account deletion only) ──────────
# Required for DELETE /account/me to remove the Supabase Auth identity.
# WHERE: dashboard → Settings (gear) → API / API Keys → "service_role" (secret) →
#        click "Reveal" to see it.
# NEVER expose this to the frontend — it is used server-side only. (The frontend
# uses the separate "anon" public key, not this one.)
SUPABASE_SERVICE_ROLE_KEY=

# ── API auth (SEC-02) ───────────────────────────────────────────────────────────
# Optional. Leave EMPTY for local/home use (recommended).
# When set, all routes (except /, /docs, /openapi.json, /redoc) require header
# `X-API-Key: <this value>`. The frontend must send the SAME value via
# VITE_API_KEY. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# ── CORS (SEC-01-4) ───────────────────────────────────────────────────────────
# Leave EMPTY to allow localhost + private-LAN origins (default — this is what
# lets you open the app from your phone/other devices on the same Wi-Fi).
# For a public domain, set a comma-separated explicit allow-list of exact origins,
# e.g. CORS_ALLOW_ORIGINS=https://tracker.example.com
CORS_ALLOW_ORIGINS=
