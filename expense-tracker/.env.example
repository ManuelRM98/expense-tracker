# Frontend environment variables
# Copy this file to .env.local and fill in the values.
# Vite bakes VITE_* variables into the compiled JS bundle at build time.

# URL of the backend API (default: http://localhost:8000)
VITE_API_URL=http://localhost:8000

# Optional: X-API-Key header value sent on every request.
# If set, the frontend will include X-API-Key: <value> in all API calls.
# Leave unset (or empty) for local development without authentication.
# VITE_API_KEY=
