# Frontend environment variables
# Copy this file to .env and fill in the values.
# Vite bakes VITE_* variables into the compiled JS bundle at build time.

# URL of the backend API. Leave unset to auto-detect from the browser's address
# (recommended for LAN/home use — the app then works from any device). Set it
# explicitly only to pin a fixed or public host.
# VITE_API_URL=http://localhost:8000

# AUTH-01: Supabase project URL — find it in Supabase dashboard → Settings → API.
VITE_SUPABASE_URL=https://<your-project>.supabase.co

# AUTH-01: Supabase public anon key — find it in Supabase dashboard → Settings → API.
# This is the public (anon) key — safe to include in the browser bundle.
# Do NOT use the service_role key here.
VITE_SUPABASE_ANON_KEY=
