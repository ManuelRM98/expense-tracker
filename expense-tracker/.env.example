# Frontend environment variables
# Copy this file to .env and fill in the values.
# Vite bakes VITE_* variables into the compiled JS bundle at build time.
#
# ┌─ WHERE TO FIND THESE (Supabase dashboard: https://supabase.com/dashboard) ─┐
# │ Open your project → gear icon "Settings" (bottom-left) → "API" / "API Keys".│
# │  • VITE_SUPABASE_URL      = "Project URL"                                   │
# │  • VITE_SUPABASE_ANON_KEY = the "anon" / "public" key (NOT service_role)    │
# │ These are the browser-safe public keys. The backend's secret keys and the  │
# │ database connection string live in expense-tracker-api/.env.example.       │
# └────────────────────────────────────────────────────────────────────────────┘

# URL of the backend API. Leave unset to auto-detect from the browser's address
# (recommended for LAN/home use — this is what lets the app work from your phone
# and other devices on the same Wi-Fi, using your Mac's LAN IP). Set it
# explicitly only to pin a fixed or public host.
# VITE_API_URL=http://localhost:8000

# Supabase project URL (AUTH-01).
# WHERE: dashboard → Settings (gear) → API → "Project URL".
# Same value as the backend's SUPABASE_URL.
VITE_SUPABASE_URL=https://<your-project>.supabase.co

# Supabase public anon key (AUTH-01).
# WHERE: dashboard → Settings (gear) → API / API Keys → "anon" / "public" key.
# This is the public key — safe to include in the browser bundle.
# Do NOT use the service_role (secret) key here — that one is backend-only.
VITE_SUPABASE_ANON_KEY=
