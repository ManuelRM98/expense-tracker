# Frontend environment variables
# Copy this file to .env.local and fill in the values.
# Vite bakes VITE_* variables into the compiled JS bundle at build time.

# URL of the backend API. Leave unset to auto-detect from the browser's address
# (recommended for LAN/home use — the app then works from any device). Set it
# explicitly only to pin a fixed or public host.
# VITE_API_URL=http://localhost:8000

# Optional: X-API-Key header value sent on every request.
# If set, the frontend includes X-API-Key: <value> in all API calls.
# This MUST match API_KEY in expense-tracker-api/.env — otherwise the backend
# returns 401 on every request. Leave unset for local dev without auth.
# VITE_API_KEY=
